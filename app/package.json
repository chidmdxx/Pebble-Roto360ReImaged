{
  "name": "roto360-reimaged",
  "author": "chidmdxx",
  "version": "2.0.1",
  "private": true,
  "pebble": {
    "displayName": "Roto360 reimaged",
    "uuid": "702a0ec9-6bd7-42d4-8bea-64d86615e312",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": ["basalt", "chalk", "emery", "gabbro"],
    "watchapp": {
      "watchface": true
    },
    "capabilities": ["configurable", "health"],
    "usesPermissions": [
      { "name": "Location", "reason": "To show weather for your saved location", "required": false },
      { "name": "ReadMusic", "reason": "To show the current track", "required": false },
      { "name": "Notifications", "reason": "To count phone notifications", "required": false },
      { "name": "Health", "reason": "To show step progress", "required": false },
      { "name": "ShowNotifications", "reason": "To report settings errors", "required": false }
    ],
    "messageKeys": ["ShowSeconds", "StepGoal", "DisableSteps", "WeatherTemperature", "WeatherUnit", "WeatherPixels", "WeatherPalette", "RequestWeather", "WeatherExpires", "CenterDisplay", "CenterOrder", "MusicTitle", "NotificationCount", "MusicExpires", "NotificationsExpire", "SlotReset", "SlotIndex", "SlotKind", "SlotText", "SlotExpires"],
    "resources": {
      "media": [
        {
          "type": "raw",
          "name": "DIGITS",
          "file": "data/digits.bin"
        },
        {
          "type": "font",
          "name": "FONT_BEBAS_12",
          "file": "fonts/BebasNeue-Regular.ttf",
          "characterRegex": "[A-Z0-9%+ \\-]",
          "targetPlatforms": ["basalt"]
        },
        {
          "type": "font",
          "name": "FONT_BEBAS_14",
          "file": "fonts/BebasNeue-Regular.ttf",
          "characterRegex": "[A-Z0-9%+ \\-]",
          "targetPlatforms": ["chalk"]
        },
        {
          "type": "font",
          "name": "FONT_BEBAS_18",
          "file": "fonts/BebasNeue-Regular.ttf",
          "characterRegex": "[A-Z0-9%+ \\-]",
          "targetPlatforms": ["emery"]
        },
        {
          "type": "font",
          "name": "FONT_BEBAS_20",
          "file": "fonts/BebasNeue-Regular.ttf",
          "characterRegex": "[A-Z0-9%+ \\-]",
          "targetPlatforms": ["gabbro"]
        }
      ]
    }
  }
}
